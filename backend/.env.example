# ---------------------------------------------------------------------------
# SkillBridge backend - environment variables (copy to .env and edit)
# ---------------------------------------------------------------------------

# Active settings module.
#   Dev (default via manage.py):   config.settings.dev
#   Prod (default via WSGI/ASGI):  config.settings.prod
# DJANGO_SETTINGS_MODULE=config.settings.dev

# ---------------------------------------------------------------------------
# Development (config.settings.dev)
# ---------------------------------------------------------------------------
# Dev uses SQLite automatically - no database config is required locally.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (frontend dev server origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# Locale
TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Auth (shared by dev and prod)
# ---------------------------------------------------------------------------
# allauth: 'mandatory' forces email verification before login, 'optional' or
# 'none' skip it. Mandatory is recommended in prod; 'none' is convenient
# during local backend development.
ACCOUNT_EMAIL_VERIFICATION=mandatory

# Default sender for account/verification/password-reset emails.
DEFAULT_FROM_EMAIL=no-reply@skillbridge.local

# django.contrib.sites row id. 1 is the default created by `migrate`.
SITE_ID=1

# Frontend SPA base URL. Used to build email verification and
# password-reset links that land on the React app.
FRONTEND_URL=http://localhost:5173

# JWT (SimpleJWT)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Defaults to SECRET_KEY if unset. Override to rotate JWT signing independently.
# JWT_SIGNING_KEY=

# Social auth - leave blank until you register apps with each provider.
# Google:   https://console.cloud.google.com/apis/credentials
# Facebook: https://developers.facebook.com/apps/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Production (config.settings.prod)
# DigitalOcean App Platform populates most of these automatically.
# ---------------------------------------------------------------------------

# SECRET_KEY=<64+ char random string - REQUIRED>
# ALLOWED_HOSTS=skillbridge.example.com
# APP_DOMAIN=skillbridge-xxxxx.ondigitalocean.app   # injected by App Platform
# CSRF_TRUSTED_ORIGINS=https://skillbridge.example.com
# CORS_ALLOWED_ORIGINS=https://skillbridge.example.com

# Database - preferred: DATABASE_URL from the managed Postgres component.
# Fallback: component DB_* env vars (used only when DATABASE_URL is unset).
# DATABASE_URL=postgresql://user:password@host:25060/skillbridge?sslmode=require
# DB_CONN_MAX_AGE=60
# DB_SSL_REQUIRE=True
# DB_NAME=skillbridge
# DB_USER=skillbridge
# DB_PASSWORD=
# DB_HOST=db.internal
# DB_PORT=5432
# DB_SSLMODE=require

# Security / cookies
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax

# Email (SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@skillbridge.example
