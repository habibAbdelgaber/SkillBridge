# SkillBridge frontend — environment variables.
# Copy to .env (or .env.local) and edit. Vite only exposes vars prefixed
# with VITE_ to client code, so don't put server-side secrets here.

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Production (DigitalOcean App Platform — static site)
# ---------------------------------------------------------------------------
# Set these as encrypted env vars on the static-site component. They're
# inlined at build time, so changing them requires a redeploy.
#
# VITE_API_URL=https://api.skillbridge.example.com
# VITE_GOOGLE_MAPS_API_KEY=<browser-restricted Google Maps key>
